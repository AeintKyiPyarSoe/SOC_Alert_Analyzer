# ==============================================================================
# SOC Alert Analyzer - Environment Configuration Template
# ==============================================================================

# Application Environment (development, staging, production)
ENVIRONMENT=development

# Authentication & RBAC Secrets
# Replace with strong, randomly generated keys in production!
AUTH_ENABLED=true
SECRET_KEY=change-me-to-a-very-secure-random-string-in-production
ADMIN_API_KEY=soc-admin-key-default-2026
ANALYST_API_KEY=soc-analyst-key-default-2026

# Database Configuration (PostgreSQL)
# When running with Docker Compose or external PostgreSQL:
POSTGRES_USER=soc_user
POSTGRES_PASSWORD=replace_with_strong_database_password
POSTGRES_DB=soc_alert_db
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Alternatively, set full DATABASE_URL directly (e.g., for SQLite or cloud database):
# DATABASE_URL=sqlite:///soc_alerts.db
# DATABASE_URL=postgresql://soc_user:password@localhost:5432/soc_alert_db

# File Upload Security Restrictions
MAX_UPLOAD_SIZE_MB=25

# Correlation Sliding Window (seconds)
CORRELATION_WINDOW_SECONDS=300

# CORS Allowed Origins (comma-separated, or * for open development)
ALLOWED_ORIGINS=*
